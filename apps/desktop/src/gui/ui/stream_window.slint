global UuStyle {
    out property <color> panel-bg: #131722f5;
    out property <color> panel-border: #2b3346;
    out property <color> card-bg: #181e2c;
    out property <color> card-border: #242d40;
    out property <color> item-bg: #202738;
    out property <color> item-hover: #2a3348;
    out property <color> item-pressed: #161c29;
    out property <color> item-border: #2c364d;
    out property <color> accent-fill: #0284c7;
    out property <color> accent-hover: #0ea5e9;
    out property <color> accent-pressed: #0369a1;
    out property <color> accent-border: #38bdf8;
    out property <color> tile-active-bg: #12304d;
    out property <color> text-primary: #f8fafc;
    out property <color> text-secondary: #cbd5e1;
    out property <color> text-muted: #94a3b8;
    out property <color> text-disabled: #526075;
    out property <color> separator: #252f42;
}

component UuPanelSurface inherits FlatSurface {
    background: UuStyle.panel-bg;
    outline-color: UuStyle.panel-border;
    border-radius: 14px;
}

component UuSettingRow inherits VerticalLayout {
    in property <string> label;
    in property <string> value-text;
    in property <color> value-color: UuStyle.accent-border;
    spacing: 4px;
    HorizontalLayout {
        height: 14px;
        spacing: 8px;
        Text {
            text: root.label;
            color: UuStyle.text-muted;
            font-size: 11px;
            overflow: elide;
            vertical-alignment: center;
        }
        if root.value-text != "": Text {
            text: root.value-text;
            color: root.value-color;
            font-size: 11px;
            font-weight: 600;
            horizontal-alignment: right;
            vertical-alignment: center;
            horizontal-stretch: 0;
        }
    }
    @children
}

component UuSensitivityRow inherits Rectangle {
    in property <string> label;
    in-out property <float> percent: 100;
    private property <int> tick-interval: 100;
    callback commit;
    height: 39px;

    Text {
        x: 0px;
        y: 0px;
        width: parent.width - 56px;
        height: 14px;
        text: root.label;
        color: UuStyle.text-muted;
        font-size: 11px;
        overflow: elide;
        vertical-alignment: center;
    }
    Text {
        x: parent.width - 52px;
        y: 0px;
        width: 52px;
        height: 14px;
        text: round(root.percent) + "%";
        color: UuStyle.accent-border;
        font-size: 11px;
        font-weight: 600;
        horizontal-alignment: right;
        vertical-alignment: center;
    }

    FlatSurface {
        x: 0px;
        y: 17px;
        width: parent.width;
        height: 22px;
        background: UuStyle.item-bg;
        outline-color: UuStyle.item-border;
        border-radius: 6px;

        rail := Rectangle {
            x: slider.x + 10px;
            width: slider.width - 20px;
            height: 4px;
            y: (slider.height - self.height) / 2;
            background: #2d364d;
            border-radius: 2px;

            pure function position-for(value: float) -> length {
                return self.width * (value - slider.minimum) / (slider.maximum - slider.minimum);
            }
            pure function value-at(x: length) -> float {
                return slider.minimum + clamp(x / max(1px, self.width), 0, 1) * (slider.maximum - slider.minimum);
            }

            // Highlight filled track up to current handle position.
            Rectangle {
                x: 0px;
                y: 0px;
                width: clamp(rail.position-for(slider.value), 0px, parent.width);
                height: parent.height;
                background: UuStyle.accent-hover;
                border-radius: 2px;
            }
            for index in (ceil(slider.maximum / root.tick-interval) - 1): Rectangle {
                private property <int> mark: (index + 1) * root.tick-interval;
                x: rail.position-for(self.mark) - self.width / 2;
                y: (parent.height - self.height) / 2;
                width: 2px;
                height: self.mark == 100 ? 10px : 7px;
                border-radius: 1px;
                background: #475569;
            }
            Rectangle {
                width: 12px;
                height: 12px;
                border-radius: 6px;
                x: rail.position-for(slider.value) - self.width / 2;
                y: (parent.height - self.height) / 2;
                background: UuStyle.text-primary;
                border-width: 1.5px;
                border-color: UuStyle.accent-border;
            }
        }
        slider := Slider {
            opacity: 0;
            x: 5px;
            y: 0px;
            width: parent.width - 10px;
            height: parent.height;
            orientation: horizontal;
            minimum: 10;
            maximum: 500;
            step: 1;
            value <=> root.percent;
            accessible-label: root.label;
            released(value) => { root.percent = round(value); root.commit(); }
        }
        TouchArea {
            private property <length> grab-offset;
            private property <bool> dragging;
            pointer-event(event) => {
                if event.button == PointerEventButton.left {
                    if event.kind == PointerEventKind.down {
                        slider.focus();
                        self.dragging = false;
                        let x = self.mouse-x - rail.x;
                        let value = rail.value-at(x);
                        let tick = clamp(round(value / root.tick-interval) * root.tick-interval,
                            root.tick-interval, slider.maximum);
                        let snap-distance = 6px;
                        if x <= snap-distance {
                            root.percent = slider.minimum;
                        } else if x >= rail.width - snap-distance {
                            root.percent = slider.maximum;
                        } else if abs(x - rail.position-for(tick)) <= snap-distance {
                            root.percent = tick;
                        } else if abs(x - rail.position-for(root.percent)) > 6.5px {
                            root.percent = round(value);
                        }
                        self.grab-offset = x - rail.position-for(root.percent);
                    } else if event.kind == PointerEventKind.up {
                        root.commit();
                    }
                }
            }
            moved => {
                if self.pressed && (self.dragging || abs(self.mouse-x - self.pressed-x) > 3px) {
                    self.dragging = true;
                    root.percent = round(rail.value-at(self.mouse-x - rail.x - self.grab-offset));
                }
            }
            scroll-event(event) => { accept }
        }
    }
}

component UuSegmentRow inherits UuSettingRow {
    in property <[string]> options;
    in property <int> selected;
    in property <bool> enabled: true;
    callback choose(int);
    height: 44px;

    HorizontalLayout {
        height: 26px;
        spacing: 5px;
        for option[index] in root.options: FlatSurface {
            height: 26px;
            background: !root.enabled ? #161b26
                : root.selected == index ? (option-touch.pressed ? UuStyle.accent-pressed : option-touch.has-hover ? UuStyle.accent-hover : UuStyle.accent-fill)
                : option-touch.pressed ? UuStyle.item-pressed
                : option-touch.has-hover ? UuStyle.item-hover : UuStyle.item-bg;
            border-radius: 7px;
            outline-color: !root.enabled ? #1e2536
                : root.selected == index ? UuStyle.accent-border
                : option-touch.has-hover ? #3b4966 : UuStyle.item-border;
            animate background, outline-color { duration: 100ms; }
            Text {
                text: option;
                color: !root.enabled ? UuStyle.text-disabled
                    : root.selected == index ? white : UuStyle.text-secondary;
                font-weight: root.selected == index ? 600 : 400;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }
            option-touch := TouchArea {
                mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
                clicked => { if root.enabled { root.choose(index); } }
                scroll-event(event) => { accept }
            }
        }
    }
}

component UuActionTile inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> active: false;
    in property <bool> action-enabled: true;
    in property <bool> muted: false;
    in property <bool> slashed: false;
    callback clicked;

    private property <bool> interactive: root.action-enabled && !root.muted;
    private property <color> fg-color: !root.interactive ? UuStyle.text-disabled
        : root.active ? UuStyle.accent-border : UuStyle.text-secondary;
    private property <color> surface-fill: !root.interactive ? #151a26
        : tile-touch.pressed ? UuStyle.item-pressed
        : root.active ? (tile-touch.has-hover ? #183d61 : UuStyle.tile-active-bg)
        : tile-touch.has-hover ? UuStyle.item-hover : #1c2333;

    height: 50px;
    background: root.surface-fill;
    border-radius: 9px;
    border-width: 1px;
    border-color: !root.interactive ? #1e2536
        : root.active ? UuStyle.accent-hover
        : tile-touch.has-hover ? #3b4966 : #273146;
    opacity: !root.interactive ? 0.55 : 1;
    animate background, border-color { duration: 100ms; }

    Rectangle {
        x: (parent.width - 22px) / 2;
        y: 8px;
        width: 22px;
        height: 18px;
        Text {
            text: root.icon;
            color: root.fg-color;
            font-family: "Font Awesome 6 Free";
            font-weight: 900;
            font-size: 14px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        // Use Paths instead of rotated rectangles so software renderer draws cleanly.
        if root.slashed: Path {
            width: 20px;
            height: 18px;
            x: 1px;
            y: 0px;
            viewbox-width: 20;
            viewbox-height: 18;
            commands: "M 3 2.5 L 17 15.5";
            stroke: root.fg-color;
            stroke-width: 1.8px;
        }
        if root.slashed: Path {
            width: 20px;
            height: 18px;
            x: 1px;
            y: 0px;
            viewbox-width: 20;
            viewbox-height: 18;
            commands: "M 1.8 4 L 15.8 17";
            stroke: root.surface-fill;
            stroke-width: 1.8px;
        }
    }

    Text {
        x: 4px;
        y: 29px;
        width: parent.width - 8px;
        height: 15px;
        text: root.label;
        color: !root.interactive ? UuStyle.text-disabled
            : root.active ? UuStyle.text-primary : UuStyle.text-secondary;
        font-size: 10.5px;
        font-weight: root.active ? 600 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }

    tile-touch := TouchArea {
        mouse-cursor: root.interactive ? MouseCursor.pointer : MouseCursor.default;
        scroll-event(event) => { accept }
        // Keep disabled tiles hit-testable so clicks inside the panel never leak to peer.
        clicked => { if root.interactive { root.clicked(); } }
    }
}

export component StreamWindow inherits Window {
    in property <string> session-title: "CrossDesk";
    title: root.session-title;
    icon: @image-url("../../../resources/linux/crossdesk_256x256.png");
    preferred-width: 1280px;
    preferred-height: 720px + (root.custom-titlebar ? 32px : 0px);
    min-width: 640px;
    min-height: 360px + (root.custom-titlebar ? 32px : 0px);
    no-frame: root.custom-titlebar;
    background: root.native-video-enabled
        ? transparent : root.custom-titlebar ? transparent : black;
    default-font-size: ImGuiFontStyle.base;

    in property <bool> custom-titlebar: false;
    in property <bool> control-hand-cursor-supported: true;
    in property <bool> native-video-enabled: false;
    // Export the actual input surface in logical pixels. Native rendering and
    // input mapping must follow the same layout, including the title bar.
    out property <length> video-area-top: content-layer.y + video.y;
    out property <length> video-area-width: video.width;
    out property <length> video-area-height: video.height;
    in property <bool> window-active: true;
    in property <bool> window-maximized: false;
    out property <bool> video-input-focused: input-focus.has-focus;
    in property <image> frame;
    in property <bool> has-frame: false;
    in property <string> status-text: "";
    in property <string> receiving-text: "";
    in property <string> service-warning: "";
    private property <bool> service-warning-expired: false;
    changed service-warning => {
        if root.service-warning == "" { root.service-warning-expired = false; }
    }
    in property <bool> remote-update-visible: false;
    in property <bool> privacy-unlock-visible: false;
    in property <bool> privacy-can-lock: false;
    out property <bool> modal-visible: root.remote-update-visible || root.privacy-unlock-visible;
    callback dismiss-privacy-unlock;
    callback lock-privacy;
    callback dismiss-remote-update;
    in property <[string]> displays;
    in-out property <int> selected-display: 0;
    in property <bool> mouse-control-enabled: true;
    in property <bool> privacy-visible: true;
    in property <bool> privacy-can-toggle: false;
    in property <bool> privacy-active: false;
    in property <bool> privacy-off: false;
    in property <bool> privacy-unsupported: false;
    in property <string> privacy-status-text: "Privacy screen";
    in property <bool> remote-cursor-active: false;
    in property <int> remote-cursor-shape: 0;
    in property <bool> audio-enabled: true;
    in property <bool> video-settings-enabled: false;
    in property <string> video-settings-feedback: "";
    in-out property <int> video-quality-index: 2;
    in-out property <int> frame-rate-index: 1;
    in-out property <int> adaptation-policy-index: 1;
    callback change-video-settings(int, int, int);
    in-out property <float> mouse-sensitivity-percent: 100;
    in-out property <float> wheel-sensitivity-percent: 100;
    in property <string> sensitivity-error;
    callback save-input-sensitivity(int, int);
    function commit-input-sensitivity() {
        root.save-input-sensitivity(round(root.mouse-sensitivity-percent), round(root.wheel-sensitivity-percent));
    }
    in property <[string]> remote-resolutions;
    in property <bool> remote-resolution-visible: false;
    in property <int> remote-resolution-index: -1;
    private property <int> resolution-selection: -1;
    changed remote-resolution-index => { root.resolution-selection = root.remote-resolution-index; }
    resolution-confirmation-timer := Timer {
        interval: 1ms;
        running: false;
        triggered => {
            self.running = false;
            root.resolution-selection = root.remote-resolution-index;
        }
    }
    function restore-confirmed-resolution() {
        resolution-confirmation-timer.running = true;
        resolution-confirmation-timer.restart();
    }
    in property <bool> remote-resolution-enabled: false;
    in property <string> remote-resolution-feedback: "";
    callback change-remote-resolution(int);
    in property <bool> fullscreen-enabled: false;
    in-out property <bool> fullscreen-transitioning: false;
    pure callback fullscreen-video-inset(length, length) -> length;
    Timer {
        running: root.fullscreen-transitioning;
        interval: 5s;
        triggered => { root.fullscreen-transitioning = false; }
    }
    in property <bool> stats-visible: false;
    in property <[NetworkStatsRow]> stats-rows;
    in property <string> stats-fps: "0";
    in property <string> stats-resolution: "";
    in property <string> stats-video-latency: "—";
    in property <string> stats-connection-latency: "—";
    in property <string> stats-connection-mode: "";
    in property <string> stats-local-endpoint;
    in property <string> stats-remote-endpoint;
    in property <string> stats-encoder: "—";
    in property <string> stats-decoder: "—";
    in property <bool> stats-encryption-enabled: false;
    in property <int> stats-latency-ms: -1;
    in property <string> stats-loss-summary: "0%";
    in property <bool> file-transfer-visible: false;
    in property <[FileTransferEntry]> file-transfers;

    callback switch-display(int);
    in property <bool> secure-attention-supported: false;
    callback send-shortcut(string);
    callback toggle-mouse-control;
    callback toggle-privacy;
    callback toggle-audio;
    callback select-file;
    callback close-file-transfer;
    pure callback can-drop-file(data-transfer) -> bool;
    callback file-dropped(data-transfer);
    callback toggle-stats;
    callback toggle-fullscreen;
    callback disconnect;
    callback stream-title-drag(int, length, length);
    callback minimize-stream-window;
    callback toggle-maximize-stream-window;
    callback close-stream-window;
    callback pointer-input(PointerEventButton, PointerEventKind, length, length);
    callback scroll-input(length, length, length, length);
    callback key-input(string, bool, bool, bool, bool, bool);
    callback keyboard-focus-changed(bool);

    // UU Floating Capsule + One-Page Dark Control Center state.
    private property <bool> control-expanded: false;
    in-out property <bool> video-menu-open: false;
    private property <bool> disconnect-confirm-open: false;
    private property <bool> resolution-list-open: false;

    private property <length> control-pill-w: 112px;
    private property <length> control-pill-h: 34px;
    private property <length> control-dock-margin: 8px;
    private property <length> control-panel-gap: 8px;

    private property <bool> control-can-idle: !root.control-expanded
        && !root.stats-visible && !root.control-drag-pending
        && !root.control-dragging && !pill-touch.has-hover
        && !root.fullscreen-transitioning;
    private property <bool> control-idle: false;
    changed control-can-idle => {
        if !root.control-can-idle { root.control-idle = false; }
    }
    Timer {
        interval: 3s;
        running: root.control-can-idle && !root.control-idle;
        triggered => { root.control-idle = true; }
    }
    private property <length> control-edge-offset: root.control-idle ? 22px : 0px;
    animate control-edge-offset { duration: 160ms; easing: ease-out; }

    private property <string> pill-latency-text:
        root.stats-connection-latency != "" && root.stats-connection-latency != "—"
            ? root.stats-connection-latency
            : root.stats-video-latency != "" && root.stats-video-latency != "—"
                ? root.stats-video-latency
                : "-- ms";
    private property <color> pill-signal-color:
        root.stats-latency-ms < 0 ? UuStyle.accent-border
            : root.stats-latency-ms <= 60 ? #22c55e
            : root.stats-latency-ms <= 130 ? #f59e0b
            : #ef4444;
    private property <[string]> fps-labels: ["30 FPS", "60 FPS", "90 FPS", "120 FPS", "144 FPS"];

    // Exact section height accounting so UU panel and tests know exact coordinates.
    private property <length> display-section-height:
        root.displays.length > 0 ? 54px : 0px;
    private property <length> resolution-dropdown-height:
        min(120px, max(28px, root.remote-resolutions.length * 26px + 8px));
    private property <length> resolution-inner-height:
        46px + (root.resolution-list-open && root.remote-resolution-enabled ? 4px + root.resolution-dropdown-height : 0px)
        + (root.remote-resolution-feedback != "" ? 24px : 0px);
    private property <length> resolution-section-height:
        root.remote-resolution-visible ? root.resolution-inner-height + 8px : 0px;
    private property <length> video-card-height:
        164px + (!root.video-settings-enabled || root.video-settings-feedback != "" ? 26px : 0px);
    private property <length> quick-grid-offset-y:
        48px + root.display-section-height + root.resolution-section-height + root.video-card-height + 8px;
    private property <length> sensitivity-card-height:
        104px + (root.sensitivity-error != "" ? 22px : 0px);
    private property <length> panel-content-height:
        root.quick-grid-offset-y + 106px + 8px + root.sensitivity-card-height + 8px + 32px + 12px;

    private property <length> available-below:
        max(0px, video.height - control.y - control.height - 16px);
    private property <length> available-above:
        max(0px, control.y - 16px);
    private property <length> panel-width:
        min(360px, max(240px, video.width - 16px));
    private property <length> panel-height:
        min(root.panel-content-height, max(120px, max(root.available-below, root.available-above)));
    private property <length> panel-x:
        root.control-docked-left
            ? clamp(control.x, 8px, max(8px, video.width - root.panel-width - 8px))
            : clamp(control.x + control.width - root.panel-width, 8px, max(8px, video.width - root.panel-width - 8px));
    private property <length> panel-y: root.control-panel-y(root.panel-height);

    private property <length> stats-header-bar-height: 26px;
    private property <length> stats-row-height: 20px;
    private property <length> stats-header-height: 20px;
    private property <length> stats-content-height:
        root.stats-header-bar-height + 8px + root.stats-header-height
        + root.stats-rows.length * root.stats-row-height + 124px;
    private property <length> stats-panel-width:
        min(320px, max(220px, video.width - 16px));
    private property <length> stats-panel-height:
        min(root.stats-content-height + 16px, max(120px, video.height - 16px));
    private property <bool> stats-side-by-side:
        root.control-expanded && video.width >= root.panel-width + root.stats-panel-width + 24px;
    private property <length> stats-panel-x:
        root.stats-side-by-side
            ? (root.control-docked-left
                ? min(root.panel-x + root.panel-width + 8px, video.width - root.stats-panel-width - 8px)
                : max(8px, root.panel-x - root.stats-panel-width - 8px))
            : (root.control-docked-left
                ? clamp(control.x, 8px, max(8px, video.width - root.stats-panel-width - 8px))
                : clamp(control.x + control.width - root.stats-panel-width, 8px, max(8px, video.width - root.stats-panel-width - 8px)));
    private property <length> stats-panel-y:
        root.stats-side-by-side
            ? clamp(root.panel-y, 8px, max(8px, video.height - root.stats-panel-height - 8px))
            : root.control-panel-y(root.stats-panel-height);

    private property <length> file-panel-x: 18px;
    private property <length> file-panel-y: video.height - min(210px, video.height * 0.35);
    private property <length> file-panel-width: min(430px, video.width * 0.6);
    private property <length> file-panel-height: min(190px, video.height * 0.32);

    out property <length> control-pill-x: control.x;
    out property <length> control-pill-y: control.y;
    out property <length> control-pill-width: control.width;
    out property <length> control-pill-height: control.height;
    out property <length> control-panel-x: root.panel-x;
    out property <length> control-panel-y-pos: root.panel-y;
    out property <length> control-panel-width: root.panel-width;
    out property <length> control-panel-height: root.panel-height;
    out property <length> quick-grid-y: root.panel-y + root.quick-grid-offset-y;
    out property <length> stats-card-x: root.stats-panel-x;
    out property <length> stats-card-y: root.stats-panel-y;
    out property <length> stats-card-width: root.stats-panel-width;
    out property <length> stats-card-height: root.stats-panel-height;

    private property <bool> control-menu-open: root.control-expanded;
    out property <bool> local-input-active: root.modal-visible || root.control-menu-open;

    changed video-menu-open => {
        if self.video-menu-open != root.control-expanded {
            root.control-expanded = self.video-menu-open;
        }
    }
    changed remote-resolution-enabled => {
        if !self.remote-resolution-enabled { root.resolution-list-open = false; }
    }
    changed control-expanded => {
        if root.video-menu-open != root.control-expanded {
            root.video-menu-open = root.control-expanded;
        }
        if !root.control-expanded {
            root.disconnect-confirm-open = false;
            root.resolution-list-open = false;
            root.commit-input-sensitivity();
        }
    }
    changed control-menu-open => {
        root.keyboard-focus-changed(!root.control-menu-open && !root.modal-visible && input-focus.has-focus);
    }
    changed window-active => {
        if !root.window-active {
            root.close-control-menus();
            root.cancel-remote-pointer();
            root.control-drag-pending = false;
            root.end-control-drag();
        }
    }
    changed mouse-control-enabled => {
        if !root.mouse-control-enabled { root.cancel-remote-pointer(); }
    }
    changed modal-visible => {
        if root.modal-visible {
            root.close-control-menus();
            root.control-drag-pending = false;
            root.end-control-drag();
        }
        // Changed handlers may run while Winit/AccessKit is building the
        // accessibility tree. Changing focus there re-enters its borrowed
        // adapter and aborts the process; defer focus to the event loop.
        input-focus-timer.running = true;
        input-focus-timer.restart();
        root.keyboard-focus-changed(!root.modal-visible);
    }
    input-focus-timer := Timer {
        interval: 1ms;
        running: false;
        triggered => {
            self.running = false;
            input-focus.focus();
        }
    }

    // Own each remote button from down through up/cancel, independent of the
    // pointer's current position or local overlays appearing during a drag.
    private property <bool> remote-left-down: false;
    private property <bool> remote-right-down: false;
    private property <bool> remote-middle-down: false;
    private property <bool> remote-pointer-active:
        root.remote-left-down || root.remote-right-down || root.remote-middle-down;
    private property <bool> control-drag-pending: false;
    private property <length> control-drag-start-x: 0px;
    private property <length> control-drag-start-y: 0px;
    private property <bool> control-docked-left: true;
    private property <bool> control-dragging: false;
    private property <length> control-drag-x: 0px;
    private property <length> control-pos-y: 8px;
    private property <length> control-press-x: 0px;
    private property <length> control-press-y: 0px;
    private property <length> titlebar-height:
        root.custom-titlebar && !root.fullscreen-enabled ? 32px : 0px;
    private property <length> window-corner-radius: 12px;
    callback begin-control-drag(length, length);
    callback move-control-drag(length, length);
    callback end-control-drag;
    pure callback is-local-control-area(length, length) -> bool;
    callback place-control-pointer(length, length) -> bool;
    private property <bool> awaiting-control-hover;
    private property <length> native-target-x;
    private property <length> native-target-y;
    private property <length> native-approach-distance: -1px;

    pure function control-panel-y(panel-h: length) -> length {
        let below = control.y + control.height + root.control-panel-gap;
        let above = control.y - root.control-panel-gap - panel-h;
        if below + panel-h <= video.height - 8px {
            return below;
        }
        if above >= 8px {
            return above;
        }
        return clamp(below, 8px, max(8px, video.height - panel-h - 8px));
    }

    function close-control-menus() {
        root.control-expanded = false;
        root.disconnect-confirm-open = false;
        root.resolution-list-open = false;
    }

    public function reset-pressed-input() {
        root.remote-left-down = false;
        root.remote-right-down = false;
        root.remote-middle-down = false;
        root.clear-control-handoff();
    }

    public function reset-input-state() {
        root.reset-pressed-input();
        root.close-control-menus();
        root.control-drag-pending = false;
        root.end-control-drag();
    }

    function cancel-remote-pointer() {
        if root.remote-pointer-active {
            root.reset-input-state();
            root.pointer-input(PointerEventButton.other, PointerEventKind.cancel,
                pointer.mouse-x, pointer.mouse-y);
        }
    }

    pure function remote-button-down(button: PointerEventButton) -> bool {
        return button == PointerEventButton.left ? root.remote-left-down
            : button == PointerEventButton.right ? root.remote-right-down
            : button == PointerEventButton.middle ? root.remote-middle-down : false;
    }

    function set-remote-button(button: PointerEventButton, down: bool) {
        if button == PointerEventButton.left { root.remote-left-down = down; }
        if button == PointerEventButton.right { root.remote-right-down = down; }
        if button == PointerEventButton.middle { root.remote-middle-down = down; }
    }

    function clear-control-handoff() {
        root.awaiting-control-hover = false;
        root.native-approach-distance = -1px;
    }

    function hand-off-control-pointer(px: length, py: length, place-native: bool) -> bool {
        if !RemoteCursor.adjusted || !root.is-local-control-area(
            RemoteCursor.adjusted-x, RemoteCursor.adjusted-y) { return false; }
        let x = RemoteCursor.adjusted-x;
        let y = RemoteCursor.adjusted-y;
        RemoteCursor.reset();
        RemoteCursor.outside-video = true;
        if place-native {
            root.awaiting-control-hover = root.place-control-pointer(x, root.video-area-top + y);
            if !root.awaiting-control-hover {
                root.native-target-x = x;
                root.native-target-y = y;
                root.native-approach-distance = abs(px - x) + abs(py - y);
            }
        }
        return true;
    }

    function approaching-native-control(x: length, y: length) -> bool {
        if root.native-approach-distance < 0px { return false; }
        let distance = abs(x - root.native-target-x) + abs(y - root.native-target-y);
        if distance > root.native-approach-distance {
            root.native-approach-distance = -1px;
            return false;
        }
        root.native-approach-distance = distance;
        return true;
    }

    function route-remote-pointer(button: PointerEventButton, kind: PointerEventKind,
        x: length, y: length) {
        if kind == PointerEventKind.cancel {
            root.cancel-remote-pointer();
        } else if kind == PointerEventKind.up {
            if root.remote-button-down(button) {
                root.set-remote-button(button, false);
                root.pointer-input(button, kind, x, y);
                if !root.remote-pointer-active { root.hand-off-control-pointer(x, y, true); }
            }
        } else if root.window-active && root.mouse-control-enabled && !root.modal-visible {
            let remote-target = root.remote-pointer-active
                || (!root.control-menu-open && !root.is-local-control-area(x, y));
            if kind == PointerEventKind.down && remote-target
                && button != PointerEventButton.other && !root.awaiting-control-hover {
                root.native-approach-distance = -1px;
                let already-grabbed = root.remote-pointer-active;
                input-focus.focus();
                root.set-remote-button(button, true);
                root.pointer-input(button, kind, x, y);
                if !already-grabbed && root.hand-off-control-pointer(x, y, false) {
                    root.set-remote-button(button, false);
                }
            } else if kind == PointerEventKind.move && remote-target {
                root.awaiting-control-hover = false;
                if root.approaching-native-control(x, y) { return; }
                root.pointer-input(button, kind, x, y);
                if !root.remote-pointer-active { root.hand-off-control-pointer(x, y, true); }
            }
        }
    }

    function route-remote-scroll(dx: length, dy: length, x: length, y: length) {
        if root.window-active && root.mouse-control-enabled && !root.control-menu-open && !root.awaiting-control-hover
            && !root.is-local-control-area(x, y) {
            root.native-approach-distance = -1px;
            root.scroll-input(dx, dy, x, y);
            if !root.remote-pointer-active { root.hand-off-control-pointer(x, y, false); }
        }
    }

    function arm-control-drag(x: length, y: length) {
        root.control-drag-start-x = x;
        root.control-drag-start-y = y;
        root.control-drag-pending = true;
    }

    function update-control-drag(button: PointerEventButton, kind: PointerEventKind,
        x: length, y: length) {
        if kind == PointerEventKind.cancel
            || (kind == PointerEventKind.up && button == PointerEventButton.left) {
            let toggle-expanded = kind == PointerEventKind.up && root.control-drag-pending
                && !root.control-dragging
                && root.window-active && !root.modal-visible
                && x >= control.x && x < control.x + control.width
                && y >= control.y && y < control.y + control.height;
            root.control-drag-pending = false;
            root.end-control-drag();
            if toggle-expanded { root.control-expanded = !root.control-expanded; }
        } else if kind == PointerEventKind.move && root.control-drag-pending {
            if !root.control-dragging
                && (abs(x - root.control-drag-start-x) >= 5px
                    || abs(y - root.control-drag-start-y) >= 5px) {
                root.begin-control-drag(root.control-drag-start-x, root.control-drag-start-y);
            }
            root.move-control-drag(x, y);
        }
    }

    is-local-control-area(pointer-x, pointer-y) => {
        if root.modal-visible { return true; }
        let over-control = !root.fullscreen-transitioning
            && pointer-x >= control.x && pointer-x <= control.x + control.width
            && pointer-y >= control.y && pointer-y <= control.y + control.height;
        let over-panel = root.control-expanded && !root.fullscreen-transitioning
            && pointer-x >= root.panel-x && pointer-x <= root.panel-x + root.panel-width
            && pointer-y >= root.panel-y && pointer-y <= root.panel-y + root.panel-height;
        let over-stats = root.stats-visible && !root.fullscreen-transitioning
            && pointer-x >= root.stats-panel-x && pointer-x <= root.stats-panel-x + root.stats-panel-width
            && pointer-y >= root.stats-panel-y && pointer-y <= root.stats-panel-y + root.stats-panel-height;
        let over-file-panel = root.file-transfer-visible
            && pointer-x >= root.file-panel-x && pointer-x <= root.file-panel-x + root.file-panel-width
            && pointer-y >= root.file-panel-y && pointer-y <= root.file-panel-y + root.file-panel-height;
        return over-control || over-panel || over-stats || over-file-panel;
    }

    begin-control-drag(press-x, press-y) => {
        let current-x = control.x;
        let current-y = control.y;
        root.control-drag-x = current-x;
        root.control-press-x = press-x - current-x;
        root.control-press-y = press-y - current-y;
        root.close-control-menus();
        root.control-dragging = true;
    }
    move-control-drag(pointer-x, pointer-y) => {
        if root.control-dragging {
            root.control-drag-x = min(max(0px, pointer-x - root.control-press-x), video.width - control.width);
            root.control-pos-y = min(max(8px, pointer-y - root.control-press-y), max(8px, video.height - control.height - 8px));
        }
    }
    end-control-drag() => {
        if root.control-dragging {
            root.control-docked-left = root.control-drag-x + control.width / 2 < video.width / 2;
            root.control-pos-y = min(max(8px, control.y), max(8px, video.height - control.height - 8px));
            root.control-dragging = false;
        }
    }

    window-surface := Rectangle {
        width: root.width;
        height: root.height;
        background: root.native-video-enabled ? transparent : black;
        border-radius:
            root.custom-titlebar && !root.fullscreen-enabled && !root.window-maximized
                ? root.window-corner-radius : 0px;
        clip: root.custom-titlebar && !root.fullscreen-enabled;

        if root.custom-titlebar && !root.fullscreen-enabled: Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: root.titlebar-height;
            background: #f6f5f4;
            z: 100;

            Text {
                x: 120px;
                width: parent.width - 240px;
                height: parent.height;
                text: root.session-title;
                color: root.window-active ? #3d3d3d : #747474;
                font-size: 12px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }
            stream-title-drag-area := TouchArea {
                width: parent.width - 120px;
                property <int> phase: self.pressed ? 1 : 0;
                changed phase => {
                    root.stream-title-drag(phase, self.mouse-x, self.mouse-y);
                }
                moved => {
                    if (self.pressed) {
                        root.stream-title-drag(2, self.mouse-x, self.mouse-y);
                    }
                }
                double-clicked => {
                    root.toggle-maximize-stream-window();
                }
            }
            stream-minimize-button := Rectangle {
                x: parent.width - 114px;
                y: 4px;
                width: 24px;
                height: 24px;
                border-radius: 12px;
                background: stream-minimize-touch.pressed ? #c0bfbc
                          : stream-minimize-touch.has-hover ? #deddda
                          : root.window-active ? #e6e6e6
                                               : transparent;
                accessible-role: button;
                accessible-label: StreamStrings.window-minimize;
                accessible-action-default => { stream-minimize-touch.clicked(); }
                Rectangle {
                    x: 8px;
                    y: 13px;
                    width: 8px;
                    height: 0.75px;
                    background: root.window-active
                        || stream-minimize-touch.has-hover
                        || stream-minimize-touch.pressed ? #454545 : #898989;
                }
                stream-minimize-touch := TouchArea {
                    clicked => { root.minimize-stream-window(); }
                }
            }
            stream-maximize-button := Rectangle {
                x: parent.width - 74px;
                y: 4px;
                width: 24px;
                height: 24px;
                border-radius: 12px;
                background: stream-maximize-touch.pressed ? #c0bfbc
                          : stream-maximize-touch.has-hover ? #deddda
                          : root.window-active ? #e6e6e6
                                               : transparent;
                accessible-role: button;
                accessible-label: root.window-maximized ? StreamStrings.window-restore : StreamStrings.window-maximize;
                accessible-action-default => { stream-maximize-touch.clicked(); }
                if !root.window-maximized: Rectangle {
                    x: 8px;
                    y: 8px;
                    width: 8px;
                    height: 8px;
                    background: transparent;
                    border-width: 1px;
                    border-color: root.window-active
                        || stream-maximize-touch.has-hover
                        || stream-maximize-touch.pressed ? #454545 : #898989;
                }
                if root.window-maximized: Rectangle {
                    x: 9px;
                    y: 7px;
                    width: 8px;
                    height: 8px;
                    background: transparent;
                    border-width: 1px;
                    border-color: root.window-active
                        || stream-maximize-touch.has-hover
                        || stream-maximize-touch.pressed ? #454545 : #898989;
                }
                if root.window-maximized: Rectangle {
                    x: 7px;
                    y: 9px;
                    width: 8px;
                    height: 8px;
                    background: stream-maximize-button.background;
                    border-width: 1px;
                    border-color: root.window-active
                        || stream-maximize-touch.has-hover
                        || stream-maximize-touch.pressed ? #454545 : #898989;
                }
                stream-maximize-touch := TouchArea {
                    clicked => { root.toggle-maximize-stream-window(); }
                }
            }
            stream-close-button := Rectangle {
                x: parent.width - 34px;
                y: 4px;
                width: 24px;
                height: 24px;
                border-radius: 12px;
                background: stream-close-touch.pressed ? #b2161d
                          : stream-close-touch.has-hover ? #e01b24
                          : root.window-active ? #e6e6e6
                                               : transparent;
                accessible-role: button;
                accessible-label: StreamStrings.window-close;
                accessible-action-default => { stream-close-touch.clicked(); }
                Path {
                    width: parent.width;
                    height: parent.height;
                    viewbox-width: 24;
                    viewbox-height: 24;
                    commands: "M 14.75 14.75 L 8.25 8.25 M 14.75 8.25 L 8.25 14.75";
                    stroke: stream-close-touch.has-hover
                        || stream-close-touch.pressed ? white
                        : root.window-active ? #454545 : #898989;
                    stroke-width: 1px;
                }
                stream-close-touch := TouchArea {
                    clicked => { root.close-stream-window(); }
                }
            }
            SurfaceSeparator {
                y: parent.height - 1px;
                height: 1px;
                outline-color: UiSurface.separator;
            }
        }

        content-layer := Rectangle {
            y: root.titlebar-height;
            width: parent.width;
            height: parent.height - self.y;
            background: root.native-video-enabled ? transparent : black;
            clip: true;

        video := Rectangle {
            y: 0px;
            height: parent.height - self.y;
            background: root.native-video-enabled ? transparent : black;
            clip: true;

            frame-image := Image {
                y: root.fullscreen-transitioning ? root.fullscreen-video-inset(root.width, root.height) : 0px;
                width: parent.width;
                height: parent.height - self.y;
                source: root.frame;
                image-fit: contain;
                visible: root.has-frame && !root.native-video-enabled;
            }

            Text {
                visible: !root.has-frame && (root.receiving-text != "" || root.status-text != "");
                text: root.receiving-text != "" ? root.receiving-text : root.status-text;
                color: root.receiving-text != "" ? #ffffffea : white;
                font-size: root.receiving-text != "" ? 14px : ImGuiFontStyle.prominent;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            drop-zone := DropArea {
                can-drop(event) => {
                    return !root.modal-visible && root.can-drop-file(event.data)
                        ? DragAction.copy : DragAction.none;
                }
                dropped(event) => {
                    if root.modal-visible { return DragAction.none; }
                    root.file-dropped(event.data);
                    return DragAction.copy;
                }
            }

            input-focus := FocusScope {
                focus-on-click: true;
                focus-gained => { root.keyboard-focus-changed(!root.control-menu-open && !root.modal-visible); }
                focus-lost => { root.keyboard-focus-changed(false); }
                key-pressed(event) => {
                    if !root.modal-visible && !root.control-menu-open {
                        root.key-input(event.text, true, event.modifiers.control, event.modifiers.alt, event.modifiers.shift, event.modifiers.meta);
                    }
                    accept
                }
                key-released(event) => {
                    if root.modal-visible {
                        if event.text == Key.Escape || event.text == Key.Return {
                            if root.privacy-unlock-visible { root.dismiss-privacy-unlock(); } else { root.dismiss-remote-update(); }
                        }
                    } else if root.control-expanded {
                        if event.text == Key.Escape {
                            root.close-control-menus();
                        }
                    } else {
                        root.key-input(event.text, false, event.modifiers.control, event.modifiers.alt, event.modifiers.shift, event.modifiers.meta);
                    }
                    accept
                }
                pointer := TouchArea {
                    private property <bool> over-local-control: root.is-local-control-area(self.mouse-x, self.mouse-y);
                    private property <bool> remote-hover-or-grab: root.remote-pointer-active
                        || (self.has-hover && !self.over-local-control);
                    mouse-cursor: self.over-local-control && !root.remote-pointer-active ? MouseCursor.default
                        : RemoteCursor.adjusted && root.mouse-control-enabled ? MouseCursor.none : root.remote-cursor-active
                        ? RemoteCursor.shape(root.remote-cursor-shape) : MouseCursor.default;
                    changed remote-hover-or-grab => {
                        if !self.remote-hover-or-grab {
                            root.clear-control-handoff();
                            RemoteCursor.reset();
                        }
                    }
                    pointer-event(event) => {
                        root.route-remote-pointer(event.button, event.kind, self.mouse-x, self.mouse-y);
                    }
                    scroll-event(event) => {
                        root.route-remote-scroll(event.delta-x, event.delta-y, self.mouse-x, self.mouse-y);
                        accept
                    }
                }
            }

            if root.remote-pointer-active || root.control-drag-pending: TouchArea {
                z: 15;
                mouse-cursor: root.control-drag-pending
                    ? (root.control-hand-cursor-supported ? MouseCursor.pointer : MouseCursor.default)
                    : RemoteCursor.adjusted ? MouseCursor.none
                    : root.remote-cursor-active ? RemoteCursor.shape(root.remote-cursor-shape)
                    : MouseCursor.default;
                pointer-event(event) => {
                    if root.control-drag-pending {
                        root.update-control-drag(event.button, event.kind, self.mouse-x, self.mouse-y);
                    } else {
                        root.route-remote-pointer(event.button, event.kind, self.mouse-x, self.mouse-y);
                    }
                }
                scroll-event(event) => {
                    if !root.control-drag-pending {
                        root.route-remote-scroll(event.delta-x, event.delta-y, self.mouse-x, self.mouse-y);
                    }
                    accept
                }
            }

            if pointer.remote-hover-or-grab && root.mouse-control-enabled && !root.modal-visible && !root.control-menu-open: AdjustedPointer {
                z: 16; shape: root.remote-cursor-active ? root.remote-cursor-shape : 0;
            }

            // UU-style Floating Capsule (collapsed state shows live latency).
            control := FlatSurface {
                visible: !root.fullscreen-transitioning;
                opacity: root.fullscreen-transitioning ? 0 : root.control-idle ? 0.62 : 1;
                animate opacity {
                    duration: root.fullscreen-transitioning ? 0ms : 160ms;
                    easing: ease-out;
                }
                x: root.control-dragging ? root.control-drag-x
                    : root.control-docked-left ? root.control-dock-margin - root.control-edge-offset
                    : parent.width - self.width - root.control-dock-margin + root.control-edge-offset;
                y: min(max(8px, root.control-pos-y), max(8px, parent.height - self.height - 8px));
                width: root.control-pill-w;
                height: root.control-pill-h;
                border-radius: 17px;
                background: pill-touch.pressed ? #1a2234f5
                    : pill-touch.has-hover || root.control-expanded ? #192030f5 : #141824eb;
                outline-color: root.control-expanded ? UuStyle.accent-hover
                    : pill-touch.has-hover ? #3b4966 : #2d374d;
                z: 12;

                // Signal dot halo + core dot
                Rectangle {
                    x: 11px;
                    y: (parent.height - self.height) / 2;
                    width: 14px;
                    height: 14px;
                    border-radius: 7px;
                    background: root.pill-signal-color;
                    opacity: 0.22;
                }
                Rectangle {
                    x: 14px;
                    y: (parent.height - self.height) / 2;
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: root.pill-signal-color;
                }

                // Live latency readout
                Text {
                    x: 29px;
                    y: 0px;
                    width: 60px;
                    height: parent.height;
                    text: root.pill-latency-text;
                    color: UuStyle.text-primary;
                    font-size: 12px;
                    font-weight: 700;
                    vertical-alignment: center;
                    overflow: elide;
                }

                // Expand / collapse chevron
                Text {
                    x: 89px;
                    y: 0px;
                    width: 16px;
                    height: parent.height;
                    text: root.control-expanded ? FontAwesomeIcons.angle-up : FontAwesomeIcons.bars;
                    color: root.control-expanded ? UuStyle.accent-border : UuStyle.text-muted;
                    font-family: "Font Awesome 6 Free";
                    font-weight: 900;
                    font-size: 11px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                pill-touch := TouchArea {
                    mouse-cursor: root.control-hand-cursor-supported ? MouseCursor.pointer : MouseCursor.default;
                    scroll-event(event) => { accept }
                    pointer-event(event) => {
                        let gx = control.x + self.mouse-x;
                        let gy = control.y + self.mouse-y;
                        if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                            root.arm-control-drag(gx, gy);
                        } else {
                            root.update-control-drag(event.button, event.kind, gx, gy);
                        }
                    }
                }
            }

            // Dismiss outside clicks on release without forwarding to the remote peer.
            if root.control-menu-open: Rectangle {
                width: parent.width;
                height: parent.height;
                z: 9;
                TouchArea {
                    mouse-cursor: MouseCursor.default;
                    pointer-event(event) => {
                        if event.kind == PointerEventKind.up { root.close-control-menus(); }
                    }
                    scroll-event(event) => { accept }
                }
            }

            // UU One-Page Dark Control Center
            if root.control-expanded && !root.fullscreen-transitioning: uu-panel := UuPanelSurface {
                x: root.panel-x;
                y: root.panel-y;
                width: root.panel-width;
                height: root.panel-height;
                clip: true;
                z: 11;

                TouchArea {
                    mouse-cursor: MouseCursor.default;
                    scroll-event(event) => { accept }
                }

                ScrollView {
                    x: 0px;
                    y: 0px;
                    width: root.panel-width;
                    height: root.panel-height;
                    viewport-width: root.panel-width;
                    viewport-height: root.panel-content-height;
                    horizontal-scrollbar-policy: always-off;
                    vertical-scrollbar-policy: as-needed;

                    VerticalLayout {
                        width: root.panel-width;
                        height: root.panel-content-height;
                        padding: 12px;
                        padding-right: root.panel-content-height > root.panel-height ? 22px : 12px;
                        spacing: 8px;

                        // 1. Header: mode badge + telemetry strip + collapse button
                        HorizontalLayout {
                            height: 28px;
                            spacing: 6px;
                            Rectangle {
                                width: max(46px, mode-badge-text.preferred-width + 14px);
                                height: 22px;
                                y: 3px;
                                border-radius: 6px;
                                background: #12304d;
                                border-width: 1px;
                                border-color: #1d4e78;
                                mode-badge-text := Text {
                                    text: root.stats-connection-mode != "" ? root.stats-connection-mode : "—";
                                    color: UuStyle.accent-border;
                                    font-size: 10.5px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                            Text {
                                horizontal-stretch: 1;
                                height: 28px;
                                text: StreamStrings.uu-latency-short + " " + root.pill-latency-text
                                    + " · " + root.stats-fps + " FPS · "
                                    + StreamStrings.uu-loss-short + " " + root.stats-loss-summary;
                                color: UuStyle.text-secondary;
                                font-size: 11px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            IconButton {
                                width: 26px;
                                height: 26px;
                                y: 1px;
                                icon: FontAwesomeIcons.xmark;
                                icon-size: 12px;
                                icon-color: UuStyle.text-muted;
                                normal-background: UuStyle.item-bg;
                                hover-background: UuStyle.item-hover;
                                pressed-background: UuStyle.item-pressed;
                                tooltip: StreamStrings.collapse-control;
                                clicked => { root.close-control-menus(); }
                            }
                        }

                        // 2. Display Switcher Pills (visible when display list exists)
                        if root.displays.length > 0: VerticalLayout {
                            height: 46px;
                            spacing: 4px;
                            Text {
                                height: 14px;
                                text: StreamStrings.uu-display-section;
                                color: UuStyle.text-muted;
                                font-size: 11px;
                                vertical-alignment: center;
                            }
                            HorizontalLayout {
                                height: 28px;
                                spacing: 6px;
                                for display[index] in root.displays: FlatSurface {
                                    height: 28px;
                                    background: index == root.selected-display
                                        ? (disp-touch.pressed ? UuStyle.accent-pressed : disp-touch.has-hover ? UuStyle.accent-hover : UuStyle.accent-fill)
                                        : disp-touch.pressed ? UuStyle.item-pressed
                                        : disp-touch.has-hover ? UuStyle.item-hover : UuStyle.item-bg;
                                    border-radius: 7px;
                                    outline-color: index == root.selected-display ? UuStyle.accent-border
                                        : disp-touch.has-hover ? #3b4966 : UuStyle.item-border;
                                    Text {
                                        x: 6px;
                                        width: parent.width - 12px;
                                        height: parent.height;
                                        text: display;
                                        color: index == root.selected-display ? white : UuStyle.text-secondary;
                                        font-weight: index == root.selected-display ? 600 : 400;
                                        font-size: root.displays.length > 3 ? 10.5px : 11px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    disp-touch := TouchArea {
                                        mouse-cursor: MouseCursor.pointer;
                                        scroll-event(event) => { accept }
                                        clicked => {
                                            root.selected-display = index;
                                            root.switch-display(index);
                                        }
                                    }
                                }
                            }
                        }

                        // 3. Optional Dark Remote Resolution Selector
                        if root.remote-resolution-visible: VerticalLayout {
                            height: root.resolution-inner-height;
                            spacing: 4px;
                            Text {
                                height: 14px;
                                text: StreamStrings.remote-resolution;
                                color: UuStyle.text-muted;
                                font-size: 11px;
                                vertical-alignment: center;
                            }
                            FlatSurface {
                                height: 28px;
                                background: !root.remote-resolution-enabled ? #161b26
                                    : res-btn-touch.pressed ? UuStyle.item-pressed
                                    : res-btn-touch.has-hover ? UuStyle.item-hover : UuStyle.item-bg;
                                outline-color: root.resolution-list-open && root.remote-resolution-enabled
                                    ? UuStyle.accent-hover : UuStyle.item-border;
                                border-radius: 7px;
                                Text {
                                    x: 10px;
                                    width: parent.width - 32px;
                                    height: parent.height;
                                    text: root.resolution-selection >= 0 && root.resolution-selection < root.remote-resolutions.length
                                        ? root.remote-resolutions[root.resolution-selection] : "—";
                                    color: root.remote-resolution-enabled ? UuStyle.text-primary : UuStyle.text-disabled;
                                    font-size: 11.5px;
                                    overflow: elide;
                                    vertical-alignment: center;
                                }
                                Text {
                                    x: parent.width - 22px;
                                    width: 14px;
                                    height: parent.height;
                                    text: root.resolution-list-open ? FontAwesomeIcons.angle-up : FontAwesomeIcons.angle-down;
                                    color: UuStyle.text-muted;
                                    font-family: "Font Awesome 6 Free";
                                    font-weight: 900;
                                    font-size: 10px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                res-btn-touch := TouchArea {
                                    enabled: root.remote-resolution-enabled;
                                    mouse-cursor: root.remote-resolution-enabled ? MouseCursor.pointer : MouseCursor.default;
                                    scroll-event(event) => { accept }
                                    clicked => { root.resolution-list-open = !root.resolution-list-open; }
                                }
                            }
                            if root.resolution-list-open && root.remote-resolution-enabled: FlatSurface {
                                height: root.resolution-dropdown-height;
                                background: #1a2130;
                                outline-color: UuStyle.card-border;
                                border-radius: 7px;
                                clip: true;
                                Flickable {
                                    x: 4px;
                                    y: 4px;
                                    width: parent.width - 8px;
                                    height: parent.height - 8px;
                                    viewport-width: self.width;
                                    viewport-height: root.remote-resolutions.length * 26px;
                                    for res[index] in root.remote-resolutions: Rectangle {
                                        y: index * 26px;
                                        width: parent.width;
                                        height: 26px;
                                        border-radius: 5px;
                                        background: index == root.resolution-selection
                                            ? UuStyle.tile-active-bg
                                            : res-opt-touch.has-hover ? UuStyle.item-hover : transparent;
                                        Text {
                                            x: 8px;
                                            width: parent.width - 30px;
                                            height: parent.height;
                                            text: res;
                                            color: index == root.resolution-selection ? UuStyle.accent-border : UuStyle.text-secondary;
                                            font-weight: index == root.resolution-selection ? 600 : 400;
                                            font-size: 11px;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                        if index == root.resolution-selection: Text {
                                            x: parent.width - 20px;
                                            width: 12px;
                                            height: parent.height;
                                            text: FontAwesomeIcons.check;
                                            color: UuStyle.accent-border;
                                            font-family: "Font Awesome 6 Free";
                                            font-weight: 900;
                                            font-size: 10px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                        res-opt-touch := TouchArea {
                                            mouse-cursor: MouseCursor.pointer;
                                            scroll-event(event) => { accept }
                                            clicked => {
                                                root.resolution-selection = index;
                                                root.resolution-list-open = false;
                                                root.change-remote-resolution(index);
                                                root.restore-confirmed-resolution();
                                            }
                                        }
                                    }
                                }
                            }
                            if root.remote-resolution-feedback != "": Text {
                                height: 20px;
                                text: root.remote-resolution-feedback;
                                color: #f59e0b;
                                font-size: 11px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }

                        // 4. Video Quality, High-Refresh FPS, & Preference Card
                        FlatSurface {
                            height: root.video-card-height;
                            background: UuStyle.card-bg;
                            outline-color: UuStyle.card-border;
                            border-radius: 10px;
                            VerticalLayout {
                                padding: 10px;
                                spacing: 6px;
                                UuSegmentRow {
                                    label: StreamStrings.video-quality;
                                    options: [StreamStrings.quality-low, StreamStrings.quality-medium, StreamStrings.quality-high];
                                    selected: root.video-quality-index;
                                    enabled: root.video-settings-enabled;
                                    choose(index) => { root.change-video-settings(index, root.frame-rate-index, root.adaptation-policy-index); }
                                }
                                UuSegmentRow {
                                    label: StreamStrings.frame-rate;
                                    value-text: root.fps-labels[clamp(root.frame-rate-index, 0, 4)];
                                    options: ["30", "60", "90", "120", "144"];
                                    selected: root.frame-rate-index;
                                    enabled: root.video-settings-enabled;
                                    choose(index) => { root.change-video-settings(root.video-quality-index, index, root.adaptation-policy-index); }
                                }
                                UuSegmentRow {
                                    label: StreamStrings.adaptation-policy;
                                    options: [StreamStrings.priority-frame-rate, StreamStrings.priority-quality, StreamStrings.priority-balanced];
                                    selected: root.adaptation-policy-index;
                                    enabled: root.video-settings-enabled;
                                    choose(index) => { root.change-video-settings(root.video-quality-index, root.frame-rate-index, index); }
                                }
                                if !root.video-settings-enabled || root.video-settings-feedback != "": Text {
                                    height: 20px;
                                    text: root.video-settings-enabled ? root.video-settings-feedback : StreamStrings.video-settings-unavailable;
                                    color: UuStyle.text-muted;
                                    font-size: 10.5px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                        }

                        // 5. Quick Action 4 x 2 Tile Grid
                        VerticalLayout {
                            height: 106px;
                            spacing: 6px;
                            HorizontalLayout {
                                height: 50px;
                                spacing: 6px;
                                UuActionTile {
                                    horizontal-stretch: 1;
                                    icon: FontAwesomeIcons.computer-mouse;
                                    label: root.mouse-control-enabled ? StreamStrings.uu-mouse-on : StreamStrings.uu-mouse-off;
                                    active: root.mouse-control-enabled;
                                    slashed: !root.mouse-control-enabled;
                                    clicked => { root.toggle-mouse-control(); }
                                }
                                UuActionTile {
                                    horizontal-stretch: 1;
                                    icon: root.audio-enabled ? FontAwesomeIcons.volume-high : FontAwesomeIcons.volume-xmark;
                                    label: root.audio-enabled ? StreamStrings.uu-audio-on : StreamStrings.uu-audio-off;
                                    active: root.audio-enabled;
                                    clicked => { root.toggle-audio(); }
                                }
                                UuActionTile {
                                    horizontal-stretch: 1;
                                    icon: FontAwesomeIcons.user-secret;
                                    label: root.privacy-status-text;
                                    active: root.privacy-active;
                                    action-enabled: root.privacy-visible && root.privacy-can-toggle;
                                    muted: !root.privacy-visible || root.privacy-unsupported;
                                    slashed: root.privacy-off && !root.privacy-unsupported;
                                    clicked => { root.toggle-privacy(); }
                                }
                                UuActionTile {
                                    horizontal-stretch: 1;
                                    icon: root.fullscreen-enabled ? FontAwesomeIcons.compress : FontAwesomeIcons.expand;
                                    label: root.fullscreen-enabled ? StreamStrings.exit-fullscreen : StreamStrings.fullscreen;
                                    active: root.fullscreen-enabled;
                                    clicked => { root.close-control-menus(); root.toggle-fullscreen(); }
                                }
                            }
                            HorizontalLayout {
                                height: 50px;
                                spacing: 6px;
                                UuActionTile {
                                    horizontal-stretch: 1;
                                    icon: FontAwesomeIcons.folder-open;
                                    label: StreamStrings.uu-file-transfer;
                                    clicked => { root.close-control-menus(); root.select-file(); }
                                }
                                UuActionTile {
                                    horizontal-stretch: 1;
                                    icon: FontAwesomeIcons.shield-halved;
                                    label: "Ctrl+Alt+Del";
                                    action-enabled: root.secure-attention-supported;
                                    muted: !root.secure-attention-supported;
                                    clicked => { root.send-shortcut("Ctrl+Alt+Del"); root.close-control-menus(); }
                                }
                                UuActionTile {
                                    horizontal-stretch: 1;
                                    icon: FontAwesomeIcons.keyboard;
                                    label: StreamStrings.uu-lock-screen;
                                    action-enabled: root.secure-attention-supported;
                                    muted: !root.secure-attention-supported;
                                    clicked => { root.send-shortcut("Win+L"); root.close-control-menus(); }
                                }
                                UuActionTile {
                                    horizontal-stretch: 1;
                                    icon: FontAwesomeIcons.signal;
                                    label: StreamStrings.uu-net-stats;
                                    active: root.stats-visible;
                                    clicked => { root.toggle-stats(); }
                                }
                            }
                        }

                        // 6. Pointer & Scroll Sensitivity Sliders Card
                        FlatSurface {
                            height: root.sensitivity-card-height;
                            background: UuStyle.card-bg;
                            outline-color: UuStyle.card-border;
                            border-radius: 10px;
                            VerticalLayout {
                                padding: 10px;
                                spacing: 6px;
                                UuSensitivityRow {
                                    label: StreamStrings.mouse-sensitivity;
                                    percent <=> root.mouse-sensitivity-percent;
                                    commit => { root.commit-input-sensitivity(); }
                                }
                                UuSensitivityRow {
                                    label: StreamStrings.wheel-sensitivity;
                                    percent <=> root.wheel-sensitivity-percent;
                                    commit => { root.commit-input-sensitivity(); }
                                }
                                if root.sensitivity-error != "": Text {
                                    height: 16px;
                                    text: root.sensitivity-error;
                                    color: #f87171;
                                    font-size: 10.5px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                        }

                        // 7. Footer: Minimize + Inline Two-Step Disconnect
                        if !root.disconnect-confirm-open: HorizontalLayout {
                            height: 32px;
                            spacing: 8px;
                            FlatSurface {
                                width: 96px;
                                height: 32px;
                                border-radius: 8px;
                                background: min-touch.pressed ? UuStyle.item-pressed
                                    : min-touch.has-hover ? UuStyle.item-hover : UuStyle.item-bg;
                                outline-color: min-touch.has-hover ? #3b4966 : UuStyle.item-border;
                                Text {
                                    text: StreamStrings.window-minimize;
                                    color: UuStyle.text-secondary;
                                    font-size: 11.5px;
                                    font-weight: 500;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                min-touch := TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    scroll-event(event) => { accept }
                                    clicked => { root.close-control-menus(); root.minimize-stream-window(); }
                                }
                            }
                            FlatSurface {
                                horizontal-stretch: 1;
                                height: 32px;
                                border-radius: 8px;
                                background: disc-touch.pressed ? #4b1d26
                                    : disc-touch.has-hover ? #3c1b23 : #2c1920;
                                outline-color: disc-touch.has-hover ? #9f3546 : #6b2532;
                                Text {
                                    text: StreamStrings.disconnect;
                                    color: #fca5a5;
                                    font-size: 12px;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                disc-touch := TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    scroll-event(event) => { accept }
                                    clicked => { root.disconnect-confirm-open = true; }
                                }
                            }
                        }
                        if root.disconnect-confirm-open: HorizontalLayout {
                            height: 32px;
                            spacing: 6px;
                            Text {
                                horizontal-stretch: 1;
                                text: StreamStrings.confirm-disconnect;
                                color: UuStyle.text-primary;
                                font-size: 11.5px;
                                font-weight: 600;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            FlatSurface {
                                width: 64px;
                                height: 32px;
                                border-radius: 8px;
                                background: cancel-disc-touch.pressed ? UuStyle.item-pressed
                                    : cancel-disc-touch.has-hover ? UuStyle.item-hover : UuStyle.item-bg;
                                outline-color: UuStyle.item-border;
                                Text {
                                    text: StreamStrings.cancel;
                                    color: UuStyle.text-secondary;
                                    font-size: 11px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                cancel-disc-touch := TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    scroll-event(event) => { accept }
                                    clicked => { root.disconnect-confirm-open = false; }
                                }
                            }
                            FlatSurface {
                                width: 82px;
                                height: 32px;
                                border-radius: 8px;
                                background: confirm-disc-touch.pressed ? #991b1b
                                    : confirm-disc-touch.has-hover ? #b91c1c : #dc2626;
                                outline-color: #f87171;
                                Text {
                                    text: StreamStrings.disconnect;
                                    color: white;
                                    font-size: 11px;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                confirm-disc-touch := TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    scroll-event(event) => { accept }
                                    clicked => {
                                        root.close-control-menus();
                                        root.disconnect();
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // UU Dark Network Telemetry Panel (beside Control Center or standalone HUD)
            if root.stats-visible && !root.fullscreen-transitioning: stats-panel := UuPanelSurface {
                x: root.stats-panel-x;
                y: root.stats-panel-y;
                width: root.stats-panel-width;
                height: root.stats-panel-height;
                z: 10;
                clip: true;

                TouchArea {
                    mouse-cursor: MouseCursor.default;
                    scroll-event(event) => { accept }
                }

                stats-table := Rectangle {
                    x: 10px;
                    y: 8px;
                    width: parent.width - 20px;
                    height: root.stats-content-height;
                    background: transparent;
                    private property <length> body-y: root.stats-header-bar-height + 8px;
                    private property <length> row-height: root.stats-row-height;
                    private property <length> label-column-width: 50px;
                    private property <length> loss-column-width:
                        max(56px, stats-loss-label.preferred-width + 12px);
                    private property <length> value-column-width:
                        (self.width - self.label-column-width - self.loss-column-width) / 2;
                    private property <length> details-right-width:
                        right-label-width-probe.preferred-width + 6px
                            + max(resolution-width-probe.preferred-width,
                                connection-latency-width-probe.preferred-width,
                                encryption-width-probe.preferred-width + 12px
                                    + (root.stats-encryption-enabled ? 14px : 0px));
                    private property <length> details-right-x:
                        min(self.width / 2 + 4px, self.width - self.details-right-width - 8px);

                    left-label-width-probe := Text {
                        visible: false;
                        text: "FPS\n" + StreamStrings.stats-video-latency
                            + "\n" + StreamStrings.stats-connection-mode;
                        font-size: ImGuiFontStyle.small;
                    }
                    right-label-width-probe := Text {
                        visible: false;
                        text: StreamStrings.stats-resolution + "\n" + StreamStrings.stats-connection-latency
                            + "\n" + StreamStrings.stats-encryption;
                        font-size: ImGuiFontStyle.small;
                    }
                    resolution-width-probe := Text {
                        visible: false;
                        text: root.stats-resolution;
                        font-size: ImGuiFontStyle.body;
                        font-weight: 600;
                    }
                    connection-latency-width-probe := Text {
                        visible: false;
                        text: root.stats-connection-latency;
                        font-size: ImGuiFontStyle.body;
                        font-weight: 600;
                    }
                    encryption-width-probe := Text {
                        visible: false;
                        text: root.stats-encryption-enabled
                            ? StreamStrings.stats-encryption-enabled : StreamStrings.stats-encryption-disabled;
                        font-size: ImGuiFontStyle.small;
                        font-weight: 600;
                    }

                    // Stats Header Row
                    HorizontalLayout {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: root.stats-header-bar-height;
                        spacing: 6px;
                        Text {
                            horizontal-stretch: 1;
                            text: StreamStrings.uu-net-stats;
                            color: UuStyle.text-primary;
                            font-size: 12px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                        IconButton {
                            width: 22px;
                            height: 22px;
                            y: 2px;
                            icon: FontAwesomeIcons.xmark;
                            icon-size: 11px;
                            icon-color: UuStyle.text-muted;
                            normal-background: UuStyle.item-bg;
                            hover-background: UuStyle.item-hover;
                            pressed-background: UuStyle.item-pressed;
                            clicked => { root.toggle-stats(); }
                        }
                    }

                    // Column Headers
                    Rectangle {
                        x: 0px;
                        y: stats-table.body-y;
                        width: parent.width;
                        height: root.stats-header-height;
                        background: #1c2333;
                        border-radius: 5px;
                        Text {
                            x: stats-table.label-column-width + 4px;
                            width: stats-table.value-column-width - 8px;
                            text: StreamStrings.stats-in;
                            color: UuStyle.text-muted;
                            font-size: ImGuiFontStyle.small;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                        Text {
                            x: stats-table.label-column-width + stats-table.value-column-width + 4px;
                            width: stats-table.value-column-width - 8px;
                            text: StreamStrings.stats-out;
                            color: UuStyle.text-muted;
                            font-size: ImGuiFontStyle.small;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                        stats-loss-label := Text {
                            x: stats-table.label-column-width + stats-table.value-column-width * 2 + 4px;
                            width: stats-table.loss-column-width - 8px;
                            text: StreamStrings.stats-loss-rate;
                            color: UuStyle.text-muted;
                            font-size: ImGuiFontStyle.small;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }

                    // Traffic Rows
                    for row[index] in root.stats-rows: Rectangle {
                        x: 0px;
                        y: stats-table.body-y + root.stats-header-height + index * stats-table.row-height;
                        width: parent.width;
                        height: stats-table.row-height;
                        background: index == root.stats-rows.length - 1 ? #122b46 : transparent;
                        border-radius: 5px;
                        Text {
                            x: 4px;
                            width: stats-table.label-column-width - 8px;
                            text: row.label;
                            color: index == root.stats-rows.length - 1 ? UuStyle.accent-border : UuStyle.text-muted;
                            font-size: ImGuiFontStyle.body;
                            font-weight: index == root.stats-rows.length - 1 ? 600 : 400;
                            vertical-alignment: center;
                        }
                        Text {
                            x: stats-table.label-column-width + 4px;
                            width: stats-table.value-column-width - 8px;
                            text: row.inbound;
                            color: index == root.stats-rows.length - 1 ? UuStyle.accent-border : UuStyle.text-secondary;
                            font-size: ImGuiFontStyle.body;
                            font-weight: index == root.stats-rows.length - 1 ? 600 : 400;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Text {
                            x: stats-table.label-column-width + stats-table.value-column-width + 4px;
                            width: stats-table.value-column-width - 8px;
                            text: row.outbound;
                            color: index == root.stats-rows.length - 1 ? UuStyle.accent-border : UuStyle.text-secondary;
                            font-size: ImGuiFontStyle.body;
                            font-weight: index == root.stats-rows.length - 1 ? 600 : 400;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Text {
                            x: stats-table.label-column-width + stats-table.value-column-width * 2 + 4px;
                            width: stats-table.loss-column-width - 8px;
                            text: row.loss-rate;
                            color: index == root.stats-rows.length - 1 ? UuStyle.accent-border : UuStyle.text-muted;
                            font-size: ImGuiFontStyle.body;
                            font-weight: index == root.stats-rows.length - 1 ? 600 : 400;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        if index < root.stats-rows.length - 2: SurfaceSeparator {
                            x: 4px;
                            y: parent.height - 1px;
                            width: parent.width - 8px;
                            height: 1px;
                            outline-color: UuStyle.separator;
                        }
                    }

                    // Codec Box
                    codec-label-width-probe := Text {
                        visible: false;
                        text: StreamStrings.stats-encoder + "\n" + StreamStrings.stats-decoder;
                        font-size: ImGuiFontStyle.small;
                    }
                    FlatSurface {
                        x: 0px;
                        y: stats-table.body-y + root.stats-header-height + root.stats-rows.length * stats-table.row-height + 72px;
                        width: parent.width;
                        height: 44px;
                        background: UuStyle.card-bg;
                        border-radius: 7px;
                        outline-color: UuStyle.card-border;
                        SurfaceSeparator {
                            x: 8px;
                            y: 22px;
                            width: parent.width - 16px;
                            height: 1px;
                            outline-color: UuStyle.separator;
                        }
                        for codec[index] in [
                            { label: StreamStrings.stats-encoder, value: root.stats-encoder },
                            { label: StreamStrings.stats-decoder, value: root.stats-decoder },
                        ]: Rectangle {
                            x: 8px;
                            y: 2px + index * 21px;
                            width: parent.width - 16px;
                            height: 19px;
                            Text {
                                x: 0px;
                                y: 0px;
                                width: codec-label-width-probe.preferred-width;
                                height: parent.height;
                                text: codec.label;
                                color: UuStyle.text-muted;
                                font-size: ImGuiFontStyle.small;
                                vertical-alignment: center;
                            }
                            ScrollingText {
                                x: codec-label-width-probe.preferred-width + 8px;
                                y: 0px;
                                width: parent.width - self.x;
                                height: parent.height;
                                text: codec.value;
                                text-color: UuStyle.text-secondary;
                                font-size: ImGuiFontStyle.body;
                                font-weight: 500;
                                align-right: true;
                            }
                        }
                    }

                    // Key Metrics Grid
                    private property <[string]> metric-values: [
                        root.stats-fps, root.stats-resolution, root.stats-video-latency,
                        root.stats-connection-latency, root.stats-connection-mode,
                        root.stats-encryption-enabled ? StreamStrings.stats-encryption-enabled
                            : StreamStrings.stats-encryption-disabled,
                    ];
                    for label[index] in [
                        "FPS", StreamStrings.stats-resolution, StreamStrings.stats-video-latency,
                        StreamStrings.stats-connection-latency, StreamStrings.stats-connection-mode,
                        StreamStrings.stats-encryption,
                    ]: Rectangle {
                        private property <string> reading: stats-table.metric-values[index];
                        private property <length> encryption-icon-width:
                            index == 5 && root.stats-encryption-enabled ? 14px : 0px;
                        x: mod(index, 2) == 1 ? stats-table.details-right-x : 6px;
                        y: stats-table.body-y + root.stats-header-height + root.stats-rows.length * stats-table.row-height
                            + 6px + floor(index / 2) * 20px;
                        width: mod(index, 2) == 1 ? stats-table.width - stats-table.details-right-x - 6px
                            : stats-table.details-right-x - 16px;
                        height: 20px;
                        metric-label := Text {
                            x: 0px;
                            y: 0px;
                            width: mod(index, 2) == 1 ? right-label-width-probe.preferred-width
                                : left-label-width-probe.preferred-width;
                            height: parent.height;
                            text: label;
                            color: UuStyle.text-muted;
                            font-size: ImGuiFontStyle.small;
                            vertical-alignment: center;
                        }
                        value-width-probe := Text {
                            visible: false;
                            text: reading;
                            font-size: index >= 4 ? ImGuiFontStyle.small : ImGuiFontStyle.body;
                            font-weight: 600;
                        }
                        metric-value := Rectangle {
                            private property <length> badge-padding: index >= 4 ? 6px : 0px;
                            private property <length> icon-width: parent.encryption-icon-width;
                            width: index >= 4
                                ? min(max(0px, parent.width - metric-label.width - 6px),
                                    value-width-probe.preferred-width + self.badge-padding * 2 + self.icon-width)
                                : max(0px, parent.width - metric-label.width - 6px);
                            x: parent.width - self.width;
                            y: 2px;
                            height: 16px;
                            border-radius: 4px;
                            background: index == 4 ? #122b46 : index == 5
                                ? (root.stats-encryption-enabled ? #103224 : #362512) : transparent;
                            Text {
                                x: parent.badge-padding;
                                y: 0px;
                                height: parent.height;
                                width: max(0px, parent.width - parent.badge-padding * 2 - parent.icon-width);
                                text: reading;
                                color: index == 4 ? UuStyle.accent-border : index == 5
                                    ? (root.stats-encryption-enabled ? #4ade80 : #fbbf24) : UuStyle.text-primary;
                                font-size: index >= 4 ? ImGuiFontStyle.small : ImGuiFontStyle.body;
                                font-weight: 600;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            mode-hover := TouchArea {
                                enabled: index == 4 && root.stats-local-endpoint != "" && root.stats-remote-endpoint != "";
                                mouse-cursor: MouseCursor.default;
                            }
                            if index == 5 && root.stats-encryption-enabled: Text {
                                x: parent.width - parent.badge-padding - 10px;
                                y: 2px;
                                width: 10px;
                                height: 12px;
                                text: FontAwesomeIcons.shield-halved;
                                font-family: "Font Awesome 6 Free";
                                font-weight: 900;
                                font-size: 10px;
                                color: #4ade80;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        if mode-hover.enabled && mode-hover.has-hover: UuPanelSurface {
                            private property <length> popup-label-w: max(local-ep-cap.preferred-width, remote-ep-cap.preferred-width);
                            private property <length> popup-val-w: max(local-ep-val.preferred-width, remote-ep-val.preferred-width);
                            width: min(stats-table.width, max(160px, self.popup-label-w + self.popup-val-w + 32px));
                            height: 48px;
                            x: clamp(metric-value.x + (metric-value.width - self.width) / 2,
                                -parent.x, stats-table.width - parent.x - self.width);
                            y: metric-value.y - self.height - 4px;
                            local-ep-cap := Text {
                                x: 10px; y: 6px; height: 16px;
                                text: StreamStrings.stats-local-endpoint;
                                color: UuStyle.text-muted; font-size: 10px; vertical-alignment: center;
                            }
                            local-ep-val := Text {
                                x: parent.popup-label-w + 16px; y: 6px;
                                width: parent.width - self.x - 10px; height: 16px;
                                text: root.stats-local-endpoint;
                                color: UuStyle.text-primary; font-size: 10.5px; font-weight: 600;
                                horizontal-alignment: right; vertical-alignment: center; overflow: elide;
                            }
                            remote-ep-cap := Text {
                                x: 10px; y: 24px; height: 16px;
                                text: StreamStrings.stats-remote-endpoint;
                                color: UuStyle.text-muted; font-size: 10px; vertical-alignment: center;
                            }
                            remote-ep-val := Text {
                                x: parent.popup-label-w + 16px; y: 24px;
                                width: parent.width - self.x - 10px; height: 16px;
                                text: root.stats-remote-endpoint;
                                color: UuStyle.text-primary; font-size: 10.5px; font-weight: 600;
                                horizontal-alignment: right; vertical-alignment: center; overflow: elide;
                            }
                        }
                    }
                }
            }

            if root.modal-visible: Rectangle {
                width: parent.width; height: parent.height;
                background: #0c162c52;
                z: 13;
                TouchArea {
                    mouse-cursor: MouseCursor.default;
                    scroll-event(event) => { accept }
                }
            }
            if root.service-warning != "" && !root.service-warning-expired && !root.modal-visible: FlatSurface {
                x: (parent.width - self.width) / 2;
                y: 12px;
                width: min(600px, parent.width - 32px);
                height: service-warning-text.preferred-height + 20px;
                background: #fff4d6;
                outline-color: #e8c56a;
                border-radius: UiRadius.surface;
                z: 12;
                Timer {
                    interval: 3s;
                    triggered => { root.service-warning-expired = true; }
                }
                service-warning-text := Text {
                    x: 12px; y: 10px; width: parent.width - 24px;
                    text: root.service-warning; color: #805b12;
                    font-size: 12px; wrap: word-wrap;
                }
            }
            if root.privacy-unlock-visible: DialogSurface {
                x: (parent.width - self.width) / 2;
                y: max(16px, (parent.height - self.height) / 2);
                width: min(460px, parent.width - 32px);
                height: unlock-message.y + unlock-message.height + 84px;
                outline-color: UiSurface.edge;
                border-radius: UiRadius.surface;
                z: 14;
                TouchArea { scroll-event(event) => { accept } }
                unlock-title := Text {
                    x: 24px; y: 24px; width: parent.width - 48px;
                    height: max(28px, self.preferred-height);
                    text: StreamStrings.privacy-unlocked-title;
                    color: #1b2433; font-size: 20px; font-weight: 600; wrap: word-wrap;
                }
                unlock-message := Text {
                    x: 24px; y: unlock-title.y + unlock-title.height + 8px;
                    width: parent.width - 48px; height: max(22px, self.preferred-height);
                    text: StreamStrings.privacy-unlocked-message;
                    color: #667085; font-size: 15px; wrap: word-wrap;
                }
                SecondaryButton {
                    x: parent.width - 244px; y: parent.height - 60px;
                    width: 104px; height: 36px;
                    text: StreamStrings.privacy-unlock-confirm;
                    clicked => { root.dismiss-privacy-unlock(); }
                }
                PrimaryButton {
                    x: parent.width - 128px; y: parent.height - 60px;
                    width: 104px; height: 36px;
                    text: StreamStrings.privacy-unlock-lock;
                    enabled: root.privacy-can-lock;
                    clicked => { root.lock-privacy(); }
                }
            }
            remote-update-banner := DialogSurface {
                visible: root.remote-update-visible && !root.privacy-unlock-visible;
                x: (parent.width - self.width) / 2;
                y: min(max(64px, parent.height * 0.18), max(16px, parent.height - self.height - 16px));
                width: min(400px, parent.width - 48px);
                height: remote-update-message.y + remote-update-message.height + 84px;
                outline-color: UiSurface.edge;
                border-radius: UiRadius.surface;
                z: 14;
                TouchArea {
                    mouse-cursor: MouseCursor.default;
                    scroll-event(event) => { accept }
                }
                remote-update-title := Text {
                    x: 24px; y: 24px; width: parent.width - 80px;
                    height: max(28px, self.preferred-height);
                    text: StreamStrings.remote-update-title;
                    color: #1b2433; font-size: 20px; font-weight: 600;
                    wrap: word-wrap;
                }
                remote-update-message := Text {
                    x: remote-update-title.x;
                    y: remote-update-title.y + remote-update-title.height + 8px;
                    width: parent.width - 48px;
                    height: max(22px, self.preferred-height);
                    text: StreamStrings.remote-update;
                    color: #667085; font-size: 15px;
                    wrap: word-wrap;
                }
                IconButton {
                    x: parent.width - 44px; y: 12px; width: 32px; height: 32px;
                    icon: FontAwesomeIcons.xmark; icon-size: 14px;
                    icon-color: ControlStyle.icon;
                    normal-background: ControlStyle.surface;
                    clicked => { root.dismiss-remote-update(); }
                }
                PrimaryButton {
                    x: parent.width - 128px; y: parent.height - 60px;
                    width: 104px; height: 36px;
                    border-radius: UiRadius.control;
                    text: StreamStrings.remote-update-dismiss;
                    text-size: 14px;
                    clicked => { root.dismiss-remote-update(); }
                }
            }

            // UU Dark File Transfer Progress Overlay at bottom-left.
            if root.file-transfer-visible: UuPanelSurface {
                x: root.file-panel-x;
                y: root.file-panel-y;
                width: root.file-panel-width;
                height: root.file-panel-height;
                border-radius: UiRadius.surface;
                z: 7;
                TouchArea {
                    mouse-cursor: MouseCursor.default;
                    scroll-event(event) => { accept }
                }
                Text {
                    x: 12px;
                    y: 9px;
                    text: StreamStrings.file-transfer;
                    color: UuStyle.text-primary;
                    font-weight: 600;
                }
                IconButton {
                    x: parent.width - 32px;
                    y: 4px;
                    width: 26px;
                    height: 26px;
                    icon: FontAwesomeIcons.xmark;
                    icon-size: 12px;
                    icon-color: UuStyle.text-muted;
                    normal-background: UuStyle.item-bg;
                    hover-background: UuStyle.item-hover;
                    pressed-background: UuStyle.item-pressed;
                    clicked => { root.close-file-transfer(); }
                }
                ScrollView {
                    x: 10px;
                    y: 34px;
                    width: parent.width - 20px;
                    height: parent.height - 44px;
                    VerticalLayout {
                        padding-right: 16px;
                        spacing: 8px;
                        for entry in root.file-transfers: VerticalLayout {
                            spacing: 3px;
                            HorizontalLayout {
                                height: 18px;
                                Text { text: entry.name; color: UuStyle.text-secondary; font-size: ImGuiFontStyle.body; overflow: elide; }
                                Text { width: 80px; text: entry.status; color: UuStyle.text-muted; font-size: ImGuiFontStyle.body; horizontal-alignment: right; }
                            }
                            Rectangle {
                                height: 6px;
                                background: #222b3d;
                                border-radius: 3px;

                                Rectangle {
                                    x: 0px;
                                    y: 0px;
                                    width: parent.width * max(0, min(1, entry.progress));
                                    height: parent.height;
                                    background: UuStyle.accent-hover;
                                    border-radius: 3px;
                                }
                            }
                            HorizontalLayout {
                                height: 14px;
                                Text { text: round(entry.progress * 100) + "%  " + entry.speed; color: UuStyle.text-muted; font-size: ImGuiFontStyle.small; }
                                Text { text: entry.size; color: UuStyle.text-muted; font-size: ImGuiFontStyle.small; horizontal-alignment: right; }
                            }
                        }
                    }
                }
            }
        }
        }

        if root.custom-titlebar && !root.fullscreen-enabled: FlatSurface {
            width: parent.width;
            height: parent.height;
            background: transparent;
            outline-color: UiSurface.edge;
            border-radius:
                root.window-maximized ? 0px : root.window-corner-radius;
            z: 200;
        }
    }
}
